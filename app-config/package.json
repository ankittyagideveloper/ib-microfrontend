{
  "name": "app-config",
  "version": "1.0.0",
  "description": "Shared webpack configuration factory for micro-frontend apps",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/webpack/webpack.js",
      "types": "./dist/webpack/webpack.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig/tsconfig.json",
    "dev": "tsc --project tsconfig/tsconfig.json --watch"
  },
  "peerDependencies": {
    "html-webpack-plugin": ">=5",
    "webpack": ">=5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "html-webpack-plugin": "^5.6.8",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2"
  },
  "dependencies": {
    "webpack-merge": "^6.0.1"
  }
}
